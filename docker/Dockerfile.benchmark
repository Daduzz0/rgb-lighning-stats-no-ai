FROM rust:1.95-slim-trixie AS builder
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates python3 pkg-config libssl-dev clang cmake && rm -rf /var/lib/apt/lists/*
WORKDIR /src
# The node commit and all submodules/dependencies are pinned by git and Cargo.lock.
ARG RLN_COMMIT=d4762ac3d1b3ca83f2f7b4f894e8569109dc572a
RUN git init . && git remote add origin https://github.com/RGB-Tools/rgb-lightning-node.git && git fetch --depth 1 origin "$RLN_COMMIT" && git checkout --detach FETCH_HEAD && git submodule update --init --recursive --depth 1
COPY instrument.py /instrument.py
COPY single_path.py /single_path.py
RUN python3 /instrument.py /src/src/ldk.rs && python3 /single_path.py /src/src/routes.rs
ENV CARGO_BUILD_JOBS=1 CARGO_PROFILE_RELEASE_DEBUG=0 CARGO_PROFILE_RELEASE_OPT_LEVEL=1 CARGO_PROFILE_RELEASE_CODEGEN_UNITS=256
RUN cargo build --locked --release

FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl && rm -rf /var/lib/apt/lists/* && groupadd -g 1000 node && useradd -u 1000 -g node -M node && mkdir /RLNdata && chown node:node /RLNdata
COPY --from=builder /src/target/release/rgb-lightning-node /usr/local/bin/rgb-lightning-node
LABEL org.opencontainers.image.source="https://github.com/RGB-Tools/rgb-lightning-node" org.opencontainers.image.revision="d4762ac3d1b3ca83f2f7b4f894e8569109dc572a" rgb.stats.instrumentation="payment-events-v1" rgb.stats.bolt11-max-paths="1" rgb.stats.routing="upstream-single-path"
USER node
ENTRYPOINT ["rgb-lightning-node"]
